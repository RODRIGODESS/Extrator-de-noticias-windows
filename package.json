{
  "name": "extrator-materias-ubuntu-v12510",
  "version": "1.25.10",
  "description": "Extrator de Materias Ubuntu Portable V1.25.10 espelhado da versão Windows",
  "main": "main.js",
  "author": "",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux AppImage --x64"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "jsdom": "^26.1.0",
    "undici": "7.29.0"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "br.com.extratormaterias.v12510.ubuntu",
    "productName": "Extrator de Materias Ubuntu V1.25.10",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "engine/**/*",
      "assets/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "linux": {
      "target": ["AppImage"],
      "category": "Utility",
      "icon": "assets/extrator-materias-moderno.png",
      "artifactName": "ExtratorMaterias-Ubuntu-Portable-V1.25.10.${ext}"
    }
  }
}
